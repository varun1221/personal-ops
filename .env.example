# Copy to .env and fill in.

# --- Obsidian ---
# Absolute path to your vault. Point at fixtures/vault while developing.
OBSIDIAN_VAULT_PATH=./fixtures/vault

# Folder (relative to vault root) where Full Calendar event notes live.
OBSIDIAN_EVENTS_FOLDER=Events

# Folder (relative to vault root) holding daily notes, named YYYY-MM-DD.md
OBSIDIAN_DAILY_FOLDER=Daily

# Note (relative to vault root) that add_task appends to by default.
OBSIDIAN_INBOX_NOTE=Inbox.md

# --- Model ---
# "anthropic" (reliable tool calls, paid) or "mistral" (free tier)
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- Gmail ---
# Path to the OAuth client secrets downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=./credentials.json
# Where the cached refresh token is written after first consent.
GMAIL_TOKEN_PATH=./token.json
